# ──────────────────────────────────────────────
# fal.ai API Key  (required)
# ──────────────────────────────────────────────
FAL_KEY=your_fal_api_key_here

# ──────────────────────────────────────────────
# OpenRouter LLM  (required)
# ──────────────────────────────────────────────
# Free-tier model used by CrewAI agents for reasoning.
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/meta-llama/llama-3.3-70b-instruct:free

# ──────────────────────────────────────────────
# Reference Asset  (optional)
# Reference Assets  (no config needed)
# ──────────────────────────────────────────────
# Name of the reference image inside /assets.
# Defaults to outfit_reference.jpg if not set.
# REFERENCE_IMAGE=outfit_reference.jpg
# All image files in /assets are auto-discovered and uploaded.
# See assets/README.md for naming conventions.
# Supported: .jpg .jpeg .png .webp .bmp .tiff .tif

# ──────────────────────────────────────────────
# fal Model Overrides  (optional)
# ──────────────────────────────────────────────
# FAL_CONDITIONED_MODEL=fal-ai/flux/dev/image-to-image
# FAL_I2V_MODEL=fal-ai/wan-i2v
# FAL_TIMEOUT=300

# ──────────────────────────────────────────────
# Logging  (optional)
# ──────────────────────────────────────────────
# LOG_LEVEL=INFO
